# Environments
venv/
env/
.venv/
.env
.env.*
# A local production env dump (what `vercel env pull` writes) carries the
# live Stripe secret, the Supabase service-role key and the Telegram token.
# It is local only and must never reach the repository.
env.*
env.production

# Databases
*.db
*.sqlite
telegram-bot/imperium.db

# Local hand-off of the shared membership secret. Never commit it.
telegram-bot/.membership-secret

